# Copy to .env (gitignored). Never commit real keys.
STEDI_API_KEY=
STEDI_MODE=mock            # mock | live (live sends real 270s to Stedi)
LLM_PROVIDER=anthropic     # anthropic | openrouter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenRouter alternative: LLM_PROVIDER=openrouter, OPENROUTER_API_KEY=..., OPENROUTER_MODEL=...
# VOB_DEBUG_DUMP=1         # local only: saves raw 271s (PHI) to ./debug
